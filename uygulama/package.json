{
  "name": "buz-kule",
  "version": "0.19.0",
  "description": "Buz Kule - dikey zÄ±plama oyunu",
  "main": "main.js",
  "author": "Yusuf",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "electronFuses": { "runAsNode": false, "enableNodeOptionsEnvironmentVariable": false, "enableNodeCliInspectArguments": false, "onlyLoadAppFromAsar": true },
    "appId": "com.yusuf.buzkule",
    "productName": "Buz Kule",
    "files": [
      "main.js",
      "src/index.html",
      "src/buz-kule.js",
      "src/varlik/kenney/LICENSE-Kenney-CC0.txt",
      "src/varlik/kenney/karakter/**/*",
      "src/varlik/ses/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Buz Kule",
      "artifactName": "Buz-Kule-Kurulum-${version}.exe"
    }
  }
}
